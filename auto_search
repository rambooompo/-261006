# ============================================================ 探索ロジック（ここから）
def build_pool(data, mkt, short, long_, hold, cost, n_days, trig="gc", pb_pct=5.0, rv_rsi=20.0):
    """きっかけが出た日（銘柄×日）だけを集め、条件の判定値と購入後リターンを付ける。"""
    cols = ["trig_" + trig] + [k for k, _ in BINARY] + sorted({c for _, c, *_ in VALUED})
    frames = []
    for code, df in data.items():
        if len(df) < 260:
            continue
        x = compute(df, short, long_, mkt, pb_pct, rv_rsi)
        t = x[cols].copy()
        t["ret"] = df["Close"].shift(-(hold + 1)) / df["Open"].shift(-1) - 1 - cost
        t["code"] = code
        t = t.iloc[-n_days:]
        frames.append(t[t["trig_" + trig] & t["ret"].notna()])
    if not frames:
        return None
    return pd.concat(frames).sort_index()


def build_combos(pool, use_market, max_k):
    atoms = {}
    for key, label in BINARY:
        if key == "market" and not use_market:
            continue
        atoms[key] = [(label, pool[key].to_numpy(bool), (key, None))]
    for cid, col, fmt, op, vals in VALUED:
        arr = pool[col].to_numpy(float)
        atoms[cid] = [(fmt.format(v), (arr >= v) if op == ">=" else (arr <= v), (cid, v)) for v in vals]
    labels, masks, specs, seen = [], [], [], set()
    for k in range(1, max_k + 1):  # 条件の少ない順に作るので、同じ対象なら少ない条件のほうが残る
        for ks in combinations(list(atoms), k):
            for opt in product(*[atoms[a] for a in ks]):
                m = opt[0][1].copy()
                for o in opt[1:]:
                    m &= o[1]
                key = m.tobytes()
                if m.all() or key in seen:  # 全件と同じ／すでにある組み合わせと同じ対象は除く
                    continue
                seen.add(key)
                labels.append(" ＋ ".join(o[0] for o in opt))
                masks.append(m)
                specs.append([o[2] for o in opt])
    return labels, np.array(masks), specs


def wilson_lb(p, n, z=1.96):
    n = np.maximum(n, 1)
    return (p + z * z / (2 * n) - z * np.sqrt(p * (1 - p) / n + z * z / (4 * n * n))) / (1 + z * z / n)


def group_stats(M, ret, win):
    """M: (組み合わせ数 × 行数) の0/1行列。各組み合わせの 件数・勝率・平均・分散。"""
    n = M.sum(1)
    nn = np.maximum(n, 1)
    mean = (M @ ret) / nn
    var = (M @ (ret ** 2)) / nn - mean ** 2
    return n, (M @ win) / nn, mean, var


def score_of(objective, n, wr, mean, var):
    if objective == "win":
        return wilson_lb(wr, n)
    return mean / np.sqrt(np.maximum(var, 1e-12) / np.maximum(n, 1))


def pick(score, n_tr, n_te, min_tr, min_te, top=TOP):
    sc = np.where((n_tr >= min_tr) & (n_te >= min_te), score, -np.inf)
    idx = np.argsort(-sc)[:top]
    return idx[np.isfinite(sc[idx])]


def search(pool, use_market, max_k, thr, objective, min_tr, min_te, n_perm, seed=0):
    mid = pool.index.min() + (pool.index.max() - pool.index.min()) / 2
    tr = np.asarray(pool.index <= mid)
    te = ~tr
    labels, masks, specs = build_combos(pool, use_market, max_k)
    ret = pool["ret"].to_numpy(np.float32)
    Mtr, Mte = masks[:, tr].astype(np.float32), masks[:, te].astype(np.float32)
    rtr, rte = ret[tr], ret[te]
    wtr, wte = (rtr >= thr).astype(np.float32), (rte >= thr).astype(np.float32)

    n_tr, wr_tr, mu_tr, var_tr = group_stats(Mtr, rtr, wtr)
    n_te, wr_te, mu_te, var_te = group_stats(Mte, rte, wte)
    train_score = score_of(objective, n_tr, wr_tr, mu_tr, var_tr)
    idx = pick(train_score, n_tr, n_te, min_tr, min_te)

    # 上位30件の中で、繰り返し登場する条件を数える（似た組み合わせが並ぶので、核になる条件を見つけるため）
    from collections import Counter
    cnt = Counter(a for i in pick(train_score, n_tr, n_te, min_tr, min_te, top=30) for a in labels[i].split(" ＋ "))
    freq = pd.DataFrame([{"条件": k, "上位30件での登場回数": v} for k, v in cnt.most_common(8)])

    base = dict(n_tr=len(rtr), n_te=len(rte), wr_tr=float(wtr.mean()), wr_te=float(wte.mean()),
                mu_tr=float(rtr.mean()), mu_te=float(rte.mean()))
    gain = lambda w, m: (w - base["wr_te"]) * 100 if objective == "win" else (m - base["mu_te"]) * 100
    obs = float(np.mean(gain(wr_te[idx], mu_te[idx]))) if len(idx) else float("nan")

    # 偶然の目安：前半・後半それぞれの中で値動きをシャッフルし、同じ手順で「選んで確かめる」
    rng = np.random.default_rng(seed)
    null = []
    for _ in range(n_perm):
        a, b = rng.permutation(rtr), rng.permutation(rte)
        wa, wb = (a >= thr).astype(np.float32), (b >= thr).astype(np.float32)
        s_n, s_w, s_m, s_v = group_stats(Mtr, a, wa)
        j = pick(score_of(objective, s_n, s_w, s_m, s_v), n_tr, n_te, min_tr, min_te)
        if len(j) == 0:
            continue
        _, w2, m2, _ = group_stats(Mte[j], b, wb)
        g = (w2 - wb.mean()) * 100 if objective == "win" else (m2 - b.mean()) * 100
        null.append(float(np.mean(g)))
    null = np.array(null)

    # 上位候補の詳細（4つの期間に分けた安定性も確認）
    q = pd.qcut(pool.index.to_series().rank(method="first"), 4, labels=False).to_numpy()
    allwin = (ret >= thr)
    rows = []
    for i in idx:
        m = masks[i]
        beat = 0
        for b in range(4):
            sel = m & (q == b)
            if sel.sum() >= 8 and allwin[sel].mean() > allwin[q == b].mean():
                beat += 1
        ok = bool(wr_te[i] > base["wr_te"] and mu_te[i] > base["mu_te"])
        rows.append({
            "条件の組み合わせ": labels[i],
            "前半 件数": int(n_tr[i]), "前半 勝率%": round(float(wr_tr[i]) * 100, 1), "前半 平均%": round(float(mu_tr[i]) * 100, 2),
            "後半 件数": int(n_te[i]), "後半 勝率%": round(float(wr_te[i]) * 100, 1), "後半 平均%": round(float(mu_te[i]) * 100, 2),
            "後半の勝率差(pt)": round((float(wr_te[i]) - base["wr_te"]) * 100, 1),
            "4期間で基準超え": f"{beat}/4",
            "判定": "◎ 後半でも有効" if ok else "× 後半は不発",
        })
    p_val = float((np.sum(null >= obs) + 1) / (len(null) + 1)) if len(null) and np.isfinite(obs) else float("nan")
    return dict(table=pd.DataFrame(rows), base=base, n_combos=len(labels), n_rows=len(pool), obs=obs,
                null=null, p=p_val, mid=mid, objective=objective, freq=freq, specs=[specs[i] for i in idx])
